# OpenClaw Voice Configuration
# Copy to .env and fill in your values

# ===================
# Required: Choose ONE of these backends
# ===================

# Option A: Connect to OpenClaw Gateway (recommended)
# This gives your voice assistant full agent context, memory, and tools
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# OPENCLAW_GATEWAY_AGENT_ID=main  # Optional: gateway agent id

# Option B: Direct OpenAI (standalone, no agent features)
# OPENAI_API_KEY=sk-your-key-here

# ===================
# Required: Text-to-Speech
# ===================

# ElevenLabs (recommended - high quality)
ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9  # Optional: custom voice

# ===================
# Optional: Server settings
# ===================

OPENCLAW_HOST=0.0.0.0
OPENCLAW_PORT=8765

# STT settings
OPENCLAW_STT_MODEL=base  # tiny, base, small, medium, large-v3-turbo
OPENCLAW_STT_DEVICE=auto  # auto, cpu, cuda, mps

# TTS fallback (if ElevenLabs not configured)
OPENCLAW_TTS_MODEL=chatterbox  # chatterbox, xtts, mock

# Auth (set to true for production)
OPENCLAW_REQUIRE_AUTH=false
# OPENCLAW_MASTER_KEY=your-master-key  # For API key management

# ===================
# Optional: OpenClaw workspace/state path overrides
# ===================
# Use these when the voice server runs outside your main OpenClaw workspace.
# Defaults point at common OpenClaw locations.

# OPENCLAW_WORKSPACE_ROOT=/path/to/workspace
# OPENCLAW_AGENTS_CONFIG=/path/to/workspace/config/agents.json
# OPENCLAW_USER_PROFILE=/path/to/workspace/USER.md
# OPENCLAW_AGENTMAIL_SEND_SCRIPT=/path/to/workspace/skills/agentmail/scripts/send_email.py

# Background task + reconnect durability files
# OPENCLAW_TASK_RUNS_DB=/home/you/.openclaw/tasks/runs.sqlite
# OPENCLAW_SESSIONS_STATE=/home/you/.openclaw/agents/main/sessions/sessions.json
# OPENCLAW_VOICE_DELIVERY_DIR=/home/you/.openclaw/voice/delivery-state
# OPENCLAW_VOICE_OUTBOX_DIR=/home/you/.openclaw/voice/outbox
